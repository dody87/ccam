#!/bin/bash
# bin/claude-status — shows usage for all Claude Code accounts detected in ~/.claude-*

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

# ─── Render helpers ───────────────────────────────────────────────────────────

print_header() {
  echo ""
  echo -e "${CYAN}${BOLD}╔══════════════════════════════════╗${RESET}"
  echo -e "${CYAN}${BOLD}║      Claude Account Status       ║${RESET}"
  echo -e "${CYAN}${BOLD}╚══════════════════════════════════╝${RESET}"
  echo ""
}

render_account() {
  local label="$1"
  local config_dir="$2"

  local active_marker=""
  if is_active "$config_dir"; then
    active_marker=" ${GREEN}${BOLD}[active]${RESET}"
  fi

  echo -e "${BOLD}▸ ${label}${RESET}${active_marker}"
  echo -e "  ${DIM}${config_dir}${RESET}"

  local credentials
  local credentials_error=0
  credentials=$(get_credentials "$config_dir") || credentials_error=$?

  if [ "$credentials_error" -eq 1 ]; then
    echo -e "  ${YELLOW}⚠ Not authenticated${RESET} — run: ${BOLD}claude-${label}${RESET} then ${BOLD}/login${RESET}"
    echo ""
    return
  elif [ "$credentials_error" -ne 0 ]; then
    echo -e "  ${RED}✗ Unable to read credentials from Keychain${RESET}"
    echo ""
    return
  fi

  local credential_info
  credential_info=$(parse_credentials "$credentials")

  local auth_status plan token
  IFS='|' read -r auth_status plan token <<< "$credential_info"

  if [ "$auth_status" = "expired" ]; then
    if [ "${CLAUDE_STATUS_DISABLE_AUTO_REFRESH:-}" != "1" ]; then
      echo -ne "  ${DIM}Refreshing expired session...${RESET}\r"
      refresh_expired_session "$config_dir" >/dev/null 2>&1 || true
      credentials_error=0
      credentials=$(get_credentials "$config_dir") || credentials_error=$?

      if [ "$credentials_error" -eq 0 ]; then
        credential_info=$(parse_credentials "$credentials")
        IFS='|' read -r auth_status plan token <<< "$credential_info"
      fi
      echo -ne "                                      \r"
    fi

    if [ "$auth_status" = "expired" ]; then
      echo -e "  ${YELLOW}⚠ Session expired${RESET} — run ${BOLD}claude-${label}${RESET} to refresh it"
      echo -e "  ${DIM}Plan:${RESET}  ${plan}"
      echo ""
      return
    fi
  elif [ "$auth_status" != "valid" ]; then
    echo -e "  ${YELLOW}⚠ Not authenticated${RESET} — run: ${BOLD}claude-${label}${RESET} then ${BOLD}/login${RESET}"
    echo ""
    return
  fi

  if [ "$auth_status" != "valid" ]; then
    echo -e "  ${YELLOW}⚠ Not authenticated${RESET} — run: ${BOLD}claude-${label}${RESET} then ${BOLD}/login${RESET}"
    echo ""
    return
  fi

  echo -ne "  ${DIM}Fetching...${RESET}\r"
  local raw
  raw=$(fetch_usage "$token")

  local parsed
  parsed=$(parse_usage "$raw")

  if [ "$parsed" = "ERROR" ] || [ -z "$parsed" ]; then
    echo -e "  ${RED}✗ Failed to fetch usage data${RESET}        "
    echo ""
    return
  fi

  local pct reset_in
  IFS='|' read -r pct reset_in <<< "$parsed"

  local bar_color
  bar_color=$(color_for_pct "$pct")
  local bar
  bar=$(render_bar "$pct")

  # Clear the "Fetching..." line
  echo -ne "                     \r"

  echo -e "  ${bar_color}${bar}${RESET} ${BOLD}${pct}%${RESET} used"
  echo -e "  ${DIM}Plan:${RESET}  ${plan}"
  echo -e "  ${DIM}Reset:${RESET} in ${reset_in}"
  echo ""
}

# ─── Main ─────────────────────────────────────────────────────────────────────

print_header

accounts=()
while IFS= read -r line; do accounts+=("$line"); done < <(get_accounts)

if [ ${#accounts[@]} -eq 0 ]; then
  echo -e "  ${YELLOW}No accounts found.${RESET}"
  echo ""
  echo -e "  Create a directory using the format ${BOLD}~/.claude-<name>${RESET}"
  echo -e "  then authenticate with: ${BOLD}CLAUDE_CONFIG_DIR=~/.claude-<name> claude${RESET}"
  echo ""
  exit 0
fi

for account in "${accounts[@]}"; do
  IFS=':' read -r label config_dir <<< "$account"
  render_account "$label" "$config_dir"
done

echo -e "${DIM}  Tip: claude-switch <name> to change the active account${RESET}"
echo ""
